{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "single-spa-react": ["./node_modules/single-spa-react/types/single-spa-react.d.ts"],
      "@h5web/shared/*": ["./src/h5web/packages/shared/src/*"],
      "@h5web/shared": ["./src/h5web/packages/shared/src/index.ts"],
      "@h5web/app": ["./src/h5web/packages/app/src/index.ts"],
      "@h5web/lib": ["./src/h5web/packages/lib/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/h5web"]
}
