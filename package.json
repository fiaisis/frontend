{
  "name": "fia",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15 <25 || >=26"
  },
  "dependencies": {
    "@emotion/react": "11.10.0",
    "@emotion/styled": "11.14.1",
    "@h5web/app": "17.0.0-beta.1",
    "@h5web/lib": "17.0.0-beta.1",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@react-three/fiber": "8.18.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.5.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "express": "5.2.1",
    "express-ws": "5.0.2",
    "i18next": "^26.4.2",
    "jwt-decode": "^4.0.0",
    "loglevel": "1.9.2",
    "monaco-editor": "^0.56.0",
    "ndarray": "1.1.1",
    "ndarray-ops": "^1.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-draggable": "^4.5.0",
    "react-ga4": "^2.1.0",
    "react-i18next": "^13.3.1",
    "react-json-pretty": "2.2.0",
    "react-monaco-editor": "^0.55.0",
    "react-reflex": "4.2.7",
    "react-router-dom": "5.3.0",
    "single-spa-react": "4.6.1",
    "three": "0.182.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "utif": "^3.1.0",
    "ws": "8.21.3"
  },
  "resolutions": {
    "@types/ndarray": "1.0.14",
    "@types/react": "18.3.11",
    "react-is": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --config .prettierrc --write"
    ],
    "src/**/*.json": [
      "prettier --config .prettierrc --write"
    ],
    "cypress/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --config .prettierrc --write"
    ]
  },
  "scripts": {
    "lint:js": "eslint --ext=ts --ext=tsx --ext=js --ext=jsx --fix ./src",
    "lint:check": "eslint src cypress",
    "typecheck": "tsc --noEmit",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "cross-env BUNDLE_REACT=true vite build",
    "preview": "vite preview --port 5001",
    "test": "vitest run --coverage",
    "test:build": "node --test scripts/plugin-build.test.mjs",
    "test:watch": "vitest",
    "serve:build": "yarn build && vite preview --port 5001",
    "serve:backend": "node server/server.js",
    "analyze": "yarn build && source-map-explorer build/main.*",
    "prepare": "husky",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:open:e2e": "cypress open --e2e",
    "cypress:run:e2e": "cypress run --e2e",
    "cypress:open:component": "cypress open --component",
    "cypress:run:component": "cypress run --component",
    "run-frontend": "yarn build && cd ../scigateway && yarn dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@cypress/react": "^10.0.0",
    "@cypress/webpack-dev-server": "^6.0.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/ndarray": "1.0.14",
    "@types/ndarray-ops": "^1.2.7",
    "@types/react-router-dom": "5.3.3",
    "@types/three": "0.182.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "cross-env": "^10.1.0",
    "cypress": "^16.0.0",
    "cypress-real-events": "^1.15.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "serve": "14.2.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@3.3.0"
}
